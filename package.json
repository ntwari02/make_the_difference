{
  "name": "make-the-difference",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:server:quiet": "QUIET_STARTUP=true npm run dev --workspace=server",
    "build:client": "npm run build --workspace=client",
    "start:server": "npm start --workspace=server",
    "start:server:quiet": "QUIET_STARTUP=true npm start --workspace=server",
    "lint:client": "npm run lint --workspace=client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:quiet": "concurrently \"npm run dev:server:quiet\" \"npm run dev:client\"",
    "build": "npm run build:client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
